# PRAMAAN backend (FastAPI). Runs with an empty .env (SQLite + mock/offline AI).
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app/backend

WORKDIR /app/backend

# Install deps first (better layer caching)
COPY backend/requirements.txt /app/backend/requirements.txt
RUN pip install --upgrade pip && pip install -r requirements.txt

# Copy the whole repo (backend imports data/ at the repo root for seeding)
COPY . /app

EXPOSE 8000

# Seed synthetic data (deterministic) then serve.
CMD ["sh", "-c", "python -m app.seed --reset && uvicorn app.main:app --host 0.0.0.0 --port 8000"]
