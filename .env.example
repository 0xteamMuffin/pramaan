# PRAMAAN — environment variables (EXAMPLE). Copy to `.env` (gitignored). Never commit real keys.

# ---- App ----
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change-me-in-prod
CORS_ORIGINS=http://localhost:3000

# ---- Database ----
DATABASE_URL=postgresql+psycopg://pramaan:pramaan@localhost:5432/pramaan
# pgvector enabled via migration

# ---- AI provider keys (all optional; system falls back to local Ollama if absent) ----
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Google Document AI (optional)
DOCAI_PROCESSOR=
GOOGLE_APPLICATION_CREDENTIALS=

# ---- Government data aggregator (Sandbox.co.in test env) ----
SANDBOX_BASE_URL=https://test-api.sandbox.co.in
SANDBOX_KEY=
SANDBOX_SECRET=
# Cashfree (optional fallback)
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=

# ---- Local LLM (offline fallback) ----
OLLAMA_BASE_URL=http://localhost:11434/v1

# ---- Storage ----
STORAGE_DIR=./uploads

# ---- Frontend ----
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
